# Set in Vercel → Project → Settings → Environment Variables (build time).
# Full https URL of the Render API, no trailing slash. Leave unset for local dev (Vite proxies /api to :4000).
VITE_API_URL=https://bhudrishti-api.onrender.com

# Optional: a MapTiler key (https://cloud.maptiler.com, Account > API keys) for the OpenStreetMap-style maps; restrict it to your site in the dashboard.
# Unset = the app falls back to Esri maps. Put the real key in frontend/.env, never here.
# VITE_MAP_API_KEY=
