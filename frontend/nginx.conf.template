server {
  listen ${PORT};
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 10m;   # GeoJSON/KML area uploads
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  include /etc/nginx/snippets/security-headers.conf;

  # Re-resolve the API through the container's own DNS server (Docker's, or the hosting platform's), so a
  # recreated backend (new IP) never causes 502s. ${PORT}, ${API_HOSTPORT} and ${NGINX_LOCAL_RESOLVERS} are
  # filled in when the container starts (defaults in frontend/Dockerfile).
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $api http://${API_HOSTPORT};

  # Server-Sent Events must not be buffered
  location /api/queries/ {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
  location /api/ {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # live data checks (sources/check, compile on a new district) can take minutes
    proxy_read_timeout 330s;
  }
  # hashed build assets never change
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
