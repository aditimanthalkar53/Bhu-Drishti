# Copy to .env and adjust.
JWT_SECRET=change-me-in-production

# Engine data source: simulated (default, offline) | planetary_computer (real Sentinel data, needs internet)
AEQE_PROVIDER=simulated
WITH_REAL_DATA=false          # set true to install the real-data Python packages into the engine image
AEQE_SIM_LATENCY=0.12         # simulated seconds per specialist-model call

# Optional LLM query compiler (otherwise the rule-based compiler is used)
# AEQE_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AEQE_LLM_MODEL=claude-sonnet-5-5
# or any OpenAI-compatible server, e.g. Ollama:
# AEQE_LLM=openai
# AEQE_LLM_BASE_URL=http://host.docker.internal:11434/v1
# AEQE_LLM_MODEL=qwen2.5:7b-instruct
