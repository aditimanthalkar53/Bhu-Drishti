# Copy to .env and fill in. Never commit .env or anything in engine/credentials/.
JWT_SECRET=                   # a long random value (`openssl rand -base64 48`); if empty the container generates one
HOST=127.0.0.1                # local `npm run dev` only: keep the API off the LAN (Docker ignores this)

# Engine: auto = demo districts (simulated) + every Indian district (live) | simulated | live
AEQE_PROVIDER=auto
AEQE_SIM_LATENCY=0.12         # simulated seconds per specialist-model call (demo districts only)
AEQE_SEQUENTIAL=spending      # anytime-valid intervals (spending) | fixed (faster, simulation-validated only)

# GDAL HTTP retries for live raster reads (slow or long-distance links truncate Cloud-Optimized GeoTIFF reads)
GDAL_HTTP_MAX_RETRY=4
GDAL_HTTP_RETRY_DELAY=2       # seconds, doubled on each retry
GDAL_HTTP_RETRY_CODES=ALL     # also retry transport errors, not only 429/5xx
GDAL_HTTP_TIMEOUT=60

# --- live data sources (all optional; each one unlocks more workflows) ---
# Microsoft Planetary Computer: no key needed.
# Copernicus Data Space (https://shapps.dataspace.copernicus.eu/dashboard → User settings → OAuth clients)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_PU_BUDGET=3000           # estimated processing units this app may use per month
# NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
# NASA Earthdata (https://urs.earthdata.nasa.gov → Generate Token); approve "NASA GESDISC DATA ARCHIVE" and LANCE in Applications
EARTHDATA_TOKEN=
# or: EARTHDATA_USERNAME= / EARTHDATA_PASSWORD=
# Google Earth Engine (AlphaEarth embeddings): service-account JSON in engine/credentials/
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=engine/credentials/service-account.json

# --- report e-mail ---
REPORT_DELIVERY=smtp          # smtp (backend sends) | n8n (approved reports are handed to the n8n workflow)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                    # Gmail: an App Password, not the account password
SMTP_FROM=
REPORT_AUTO_EMAIL=            # every generated report (summary + technical PDF) is emailed here automatically; comma-separated

# --- accounts ---
SQLITE_PATH=./data/bhu-drishti.sqlite   # users, logins, projects, reports (local `npm run dev`; Docker uses /data in a volume)
# DATABASE_URL=postgresql://…?sslmode=require   # Postgres (e.g. free Neon) instead of the SQLite file; recommended on free hosts
WEB_PORT=8080                # docker compose: the port the website is published on
PUBLIC_APP_URL=http://localhost:8080   # the address users open (password-reset links); set automatically on Hugging Face
TRUST_PROXY=1                # proxies in front of the app (1 on most hosts); local `npm run dev`: false
MAX_CONCURRENT_RUNS=2        # analyses one user may run at the same time

# Optional LLM query compiler (otherwise the rule-based compiler is used)
# AEQE_LLM=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AEQE_LLM_MODEL=claude-sonnet-5-5
