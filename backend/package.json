{
  "name": "satquery-backend",
  "version": "0.2.0",
  "private": true,
  "description": "SatQuery AI application API (Node.js + Fastify): auth, projects, query sessions, API keys, and a relay to the AEQE engine.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.4.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
